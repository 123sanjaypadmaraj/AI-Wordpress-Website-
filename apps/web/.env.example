# Copy to .env.local for local dev, or set in the Vercel dashboard
# (Project -> Settings -> Environment Variables) for deployed environments.

# Public base URL of the deployed apps/agent API (no trailing slash).
# apps/agent manages Docker containers directly, so it CANNOT be hosted on
# Vercel -- deploy it separately to a host with Docker access (a VPS,
# Fly.io/Railway machine, etc.) and point this at its public URL.
# Falls back to http://localhost:4001 if unset, which only works for local dev.
NEXT_PUBLIC_AGENT_URL=https://your-agent-host.example.com
