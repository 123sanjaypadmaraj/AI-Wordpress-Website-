# Copy to .env.local for local dev, or set in the Vercel dashboard
# (Project -> Settings -> Environment Variables) for deployed environments.

# Base URL of the deployed apps/agent API (no trailing slash). apps/agent
# manages Docker containers directly, so it CANNOT be hosted on Vercel --
# deploy it separately to a host with Docker access (a VPS, Fly.io/Railway
# machine, etc.) and point this at its public URL.
# Falls back to http://localhost:4001 if unset, which only works for local dev.
#
# The browser no longer talks to this URL directly (see app/api/agent/ --
# it's a same-origin proxy) -- this only needs to be reachable from wherever
# apps/web itself runs (Vercel's servers, or your own Node host), not from
# end users' browsers. It has kept the NEXT_PUBLIC_ prefix it originally had
# for continuity with existing deployment docs; nothing sensitive is in it.
NEXT_PUBLIC_AGENT_URL=https://your-agent-host.example.com

# Shared secret sent as the X-Agent-Key header on every proxied request --
# must match apps/agent's AGENT_API_KEY exactly (see apps/agent/.env.example).
# SERVER-ONLY: deliberately has no NEXT_PUBLIC_ prefix. Giving it one would
# bake this secret into the client-side JS bundle, handing it to every
# visitor's browser -- the exact leak the app/api/agent/ proxy exists to
# avoid. Leave blank to match an agent running with no AGENT_API_KEY set
# (local dev only).
AGENT_API_KEY=
