# Copy to .env in this directory (apps/agent/.env) and fill in as needed.
# Nothing here is required to run the agent -- omit every key below and
# requirement gathering, edit classification, copywriting, and the visual
# critic all fall back to local heuristics.

# --- AI provider (pick one) -------------------------------------------------
# Set exactly one of these three keys to turn on AI-assisted requirement
# extraction, edit-intent classification, copywriting, and visual critique
# (see apps/agent/src/llm/client.ts). If you set more than one, AI_PROVIDER
# below picks which is used; with no override the first of these three found
# wins, in this order: Anthropic, then Gemini, then Groq.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Force a specific provider when more than one key above is set. One of:
# anthropic | gemini | groq. Leave blank to use the priority order above.
AI_PROVIDER=

# Optional model overrides -- sensible defaults are used if left blank.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Live "skill pack" discovery (apps/agent/src/engine/skills.ts): when a chat
# message names a capability outside the curated FEATURE_PLUGIN_MAP (e.g.
# "add a real estate listings feature"), the agent searches the public
# WordPress.org plugin directory for a matching, well-rated, widely-installed
# plugin instead of ignoring the request. Fully offline-safe -- any network
# failure just means nothing is found. Set to "curated" to disable and only
# ever use the fixed local plugin catalog.
# SKILL_SOURCE=curated

# Live theme discovery (apps/agent/src/engine/themes.ts): the Themes tab is
# populated by searching the real themes.wordpress.org repository (several
# queries -- site type, visual style, and a general "wordpress" query --
# merged with the small curated THEME_CATALOG seed list) rather than showing
# only that handwritten shortlist. Fully offline-safe -- any network failure
# falls back to the curated catalog alone. Set to "catalog" to disable live
# lookup entirely (useful with no internet access).
# THEME_SOURCE=catalog

# How many theme recommendations recommendThemes() returns to the frontend,
# and how many results are requested per live WordPress.org search query
# before scoring/sorting/deduping. Raise these for an even bigger Themes tab;
# lower THEME_LIVE_FETCH_LIMIT if the wp.org API rate-limits you.
# THEME_RESULT_LIMIT=24
# THEME_LIVE_FETCH_LIMIT=30

# Port the agent HTTP API listens on.
PORT=4001

# FND-06: Postgres connection string for the application database (project
# metadata, chat history, checkpoints). Omit to use the zero-config JSON
# file store instead -- see apps/agent/src/db/store.ts. A local instance is
# available via `docker compose -f infrastructure/docker/postgres/docker-compose.yml up -d`.
DATABASE_URL=

# --- Production hardening (see docs/SECURITY.md) ----------------------------
# Every route on this server (except /health) has Docker-socket-level power:
# spinning up/tearing down containers and running arbitrary WP-CLI against a
# real DB, per project. The two vars below are what stand between "anyone who
# can reach this port" and that. Both are optional ONLY because local dev
# needs to work with zero setup -- see the startup warning in server.ts if
# AGENT_API_KEY is left unset.

# CORS: the one origin allowed to call this API from a browser. Should be
# wherever apps/web is actually served from -- mirrors apps/web/.env.example's
# NEXT_PUBLIC_AGENT_URL convention, just pointed the other direction.
WEB_ORIGIN=http://localhost:3000

# Shared secret required on every request (as an `X-Agent-Key` header) to
# every route except /health. Generate one with, e.g.,
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Leave blank ONLY for local-only dev -- with it unset, this server accepts
# every request from anyone who can reach it, unauthenticated. apps/web's
# app/api/agent/ proxy route reads the matching value from its OWN
# AGENT_API_KEY (server-only, see apps/web/.env.example) and attaches it on
# the browser's behalf, so the browser itself never needs to know this value.
AGENT_API_KEY=
